# Normalise to LF in the repository and on checkout. The deploy workflow runs an
# inline bash block on ubuntu; if it were ever checked out with CRLF, bash would
# see a stray \r at the end of every line and fail in a way that reads like
# nonsense.
* text=auto eol=lf

# Generated binaries — never touch these.
*.png binary
*.m4a binary
*.wav binary
