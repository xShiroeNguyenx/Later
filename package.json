{
  "name": "later",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tiny web app for nights when your mind won't stop.",
  "license": "MIT",
  "keywords": [
    "sleep",
    "insomnia",
    "overthinking",
    "ambient",
    "rain",
    "pwa",
    "breathing"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "audio": "node scripts/gen-audio.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "assets": "npm run audio && npm run icons",
    "size": "node scripts/size.mjs",
    "check-base": "node scripts/check-base.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
